// A launch configuration that launches the extension inside a new window
{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": ["--extensionDevelopmentPath=${workspaceRoot}"],
            "preLaunchTask": "prelanch"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach language server",
            "port": 21780
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debugger",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/src/client/debugger.js",
            "args": ["--server=4711"],
            "preLaunchTask": "prelanch"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "test_parse",
            "program": "${workspaceRoot}/src/server/test_parse.js",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "parseHBDoc",
            "program": "${workspaceRoot}/src/server/parseHBDoc.js"
        }
    ],
    "compounds": [
        {
            "name": "Extension + Debugger",
            "configurations": ["Extension", "Debugger"]
        }
    ]
}
